# ──────────────────────────────────────────────────────────
# PixelVault Environment Configuration
# Copy to .env and fill in your values.
# ──────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://pixelvault:changeme@db:5432/pixelvault?sslmode=disable

# PostgreSQL credentials (used by the postgres Docker service)
POSTGRES_DB=pixelvault
POSTGRES_USER=pixelvault
POSTGRES_PASSWORD=changeme

# ── Authentication ────────────────────────────────────────
# Strong random secret for signing JWTs (min 32 chars)
JWT_SECRET=change_me_to_a_very_long_random_secret_string_at_least_32_chars

# Access token expiry in minutes (default: 15)
JWT_EXPIRY_MIN=15

# Refresh token expiry in days (default: 30)
REFRESH_EXPIRY_DAYS=30

# Strong random secret for HMAC-signed media URLs (min 32 chars)
SIGNED_URL_SECRET=another_long_random_secret_for_signed_urls_32_chars_min

# ── Storage ───────────────────────────────────────────────
# 'local' or 'minio'
STORAGE_TYPE=minio

# Local storage path (used when STORAGE_TYPE=local)
LOCAL_STORAGE_PATH=./storage

# ── MinIO ─────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pixelvault
# Set to true if MinIO is behind HTTPS
MINIO_USE_SSL=false

# ── Server ────────────────────────────────────────────────
SERVER_PORT=8080

# Allowed CORS origins (comma-separated or *)
ALLOWED_ORIGINS=*

# ── Upload ────────────────────────────────────────────────
# Chunk size for resumable uploads in MB (default: 5)
UPLOAD_CHUNK_SIZE_MB=5

# ── Thumbnails ────────────────────────────────────────────
# Thumbnail dimension in pixels (default: 256)
THUMBNAIL_SIZE=256
